CHEXU_MODE=live
CHEXU_DATABASE_SCHEMA=public
CHEXU_CHECKPOINT_SCHEMA=chexu_agent
CHEXU_MAX_MODEL_CALLS=4
CHEXU_MAX_TOOL_CALLS=6
CHEXU_ACCESS_TOKEN_TTL_MINUTES=480
CHEXU_LOGIN_MAX_FAILURES=5
CHEXU_LOGIN_LOCK_MINUTES=15
CHEXU_APPROVAL_TTL_MINUTES=1440
CHEXU_APPROVAL_MAX_RESUME_ATTEMPTS=3
CHEXU_MAX_RUN_SECONDS=60
CHEXU_MODEL_TIMEOUT_SECONDS=20
CHEXU_TOOL_TIMEOUT_SECONDS=5
CHEXU_DB_LOCK_TIMEOUT_SECONDS=2
CHEXU_MAX_RUN_RESUMES=3
CHEXU_REPORT_STORAGE_DIR=data/reports
CHEXU_MAX_REPORT_BYTES=10485760
CHEXU_MAX_REPORT_TEXT_CHARS=60000
CHEXU_REPORT_MCP_TIMEOUT_SECONDS=20
CHEXU_TASK_WORKER_ENABLED=true
CHEXU_TASK_QUEUE_NAME=chexu
CHEXU_TASK_WORKERS=1
CHEXU_TASK_POLL_SECONDS=0.5
CHEXU_TASK_MAX_PENDING_PER_EMPLOYEE=5
CHEXU_TASK_STREAM_SECONDS=30
CHEXU_PLAN_MAX_STEPS=6
CHEXU_PLAN_MAX_MODEL_CALLS=16
CHEXU_PLAN_MAX_TOOL_CALLS=24
CHEXU_PLAN_MAX_RUN_SECONDS=180
CHEXU_PLAN_MAX_PARALLEL=2
CHEXU_PLAN_MAX_REPLANS=1
CHEXU_PLAN_MAX_REVISIONS=5
CHEXU_SUBAGENT_HANDOFF_MAX_CHARS=16000
CHEXU_SUBAGENT_CONTEXT_MAX_CHARS=48000
CHEXU_CONTEXT_WINDOW_TOKENS=32000
CHEXU_CONTEXT_OUTPUT_TOKENS=2000
CHEXU_CONTEXT_SUMMARY_TOKENS=6000
CHEXU_CONTEXT_COMPACT_RATIO=0.75
CHEXU_CONTEXT_RECENT_TURNS=4
# Tavily is optional. Configure a key to enable live web search.
CHEXU_TAVILY_API_KEY=
CHEXU_TAVILY_TIMEOUT_SECONDS=10
CHEXU_TAVILY_MAX_RESULTS=5
CHEXU_TAVILY_USE_ENV_PROXY=true
CHEXU_MODEL_BASE_URL=https://your-provider.example/v1
CHEXU_MODEL_NAME=your-tool-calling-model
CHEXU_MODEL_USE_ENV_PROXY=true
CHEXU_MODEL_API_KEY=replace-with-your-key
CHEXU_DATABASE_URL=postgresql+psycopg://chexu:replace-with-your-database-password@127.0.0.1:5432/chexu
